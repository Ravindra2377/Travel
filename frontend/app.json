{
  "expo": {
    "name": "CompareZ",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_new.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fafafa"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panviravindra.comparez",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CompareZ uses your location to show you the best prices and delivery times in your area.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_new.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.panviravindra.comparez",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon_new.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CompareZ to use your location to find the best delivery prices."
        }
      ],
      "expo-audio"
    ],
    "owner": "panvi",
    "extra": {
      "eas": {
        "projectId": "ec01b9de-1d85-4ca6-a808-0055cf954368"
      }
    }
  }
}
