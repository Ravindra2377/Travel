{
  "expo": {
    "name": "CompareZ",
    "slug": "frontend",
    "version": "1.0.2",
    "icon": "./assets/icon_new.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#F7F8F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panviravindra.comparez",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CompareZ uses your location to show you the best prices and delivery times in your area.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_new.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.panviravindra.comparez",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon_new.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CompareZ to use your location to find the best delivery prices."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "panvi_ravindra",
    "extra": {
      "eas": {
        "projectId": "48c7f27e-faae-4b8a-beea-ebb9978b9dde"
      }
    }
  }
}
