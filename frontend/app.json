{
  "expo": {
    "name": "Trip Moments",
    "slug": "frontend",
    "version": "1.0.2",
    "icon": "./assets/icon_new.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F8F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panviravindra.comparez",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trip Moments uses your location to auto-tag places and draw your travel route.",
        "NSCameraUsageDescription": "Capture travel photos and moments directly in your trip story.",
        "NSPhotoLibraryUsageDescription": "Import travel photos into your trip timeline.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_new.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.panviravindra.comparez",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon_new.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Trip Moments to use your location to auto-tag places and draw your travel route."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "owner": "panvi_ravindra",
    "extra": {
      "eas": {
        "projectId": "48c7f27e-faae-4b8a-beea-ebb9978b9dde"
      }
    }
  }
}
