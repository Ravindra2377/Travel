# CompareX Local Seed Script Configuration
# Copy this to .env.local and fill in your values

# Backend URL (where your API is deployed or running locally)
# For Render:
BACKEND_URL=https://your-app.onrender.com

# For local development:
# BACKEND_URL=http://localhost:8080

# Backend secret (use your actual secret from backend config)
# This prevents unauthorized bulk uploads
BACKEND_SECRET=your-secret-here

# Optional: Custom timeout values (in milliseconds)
PAGE_LOAD_TIMEOUT=30000
SCRAPE_TIMEOUT=12000

# Optional: Number of products per query per platform
# (default: 6, adjust if you want more/fewer)
PRODUCTS_PER_QUERY=6
